#!/usr/bin/env bash
# Claude Code 모드 런처. 파일 이름(claude-personal / claude-work / claude-lite)이 모드가 된다.
#
# 사용:
#   claude-personal [claude 옵션...]        개인 프로젝트 (main 직접, 커밋 전 묻기)
#   claude-work     [claude 옵션...]        회사/협업 (브랜치 + PR, 병합은 사람)
#   claude-lite [-d 문서.md] [claude 옵션]   문서 규약 없이, 지정 문서만 읽고 작업
#   (모든 모드 공통) -d 문서.md : 이번 세션에서 우선 따를 지시 문서 지정
#   세션 중 끄고 켜기: ai-board off|on  (세션 안에서는 앞에 ! 를 붙여 실행)
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
mode="${0##*/}"
mode="${mode#claude-}"

case "$mode" in
  personal|work|lite) ;;
  *) echo "알 수 없는 모드: $mode (claude-personal | claude-work | claude-lite 이름으로 실행)" >&2; exit 2 ;;
esac

doc=""
if [[ "${1:-}" == "-d" ]]; then
  [[ -n "${2:-}" && -f "$2" ]] || { echo "-d 뒤에 존재하는 문서 경로가 필요합니다" >&2; exit 2; }
  doc="$(readlink -f "$2")"
  shift 2
fi

if [[ "$mode" == "lite" ]]; then
  files=(lite.md)
else
  # 모드별 규칙(personal.md / work.md)은 넣지 않는다. 세션 중 모드를 바꿀 수 있어서 훅이 요청마다 현재 모드의 규칙을 넣어 준다
  files=(core.md review-gate.md board.md)
fi

prompt="[AI-MODE: $mode]"$'\n'
prompt+="이 블록은 사용자가 선택한 이번 세션의 작업 규칙이다. ~/.claude/CLAUDE.md 의 기본 모드 안내보다 우선한다."$'\n'
if [[ "$mode" != "lite" ]]; then
  prompt+="시작 모드는 $mode 이다. 사용자가 세션 중 기록을 끄고 켤 수 있고(off/on), 현재 모드의 규칙은 요청마다 [ai-board 현재 모드: …] 블록으로 들어온다. 그 블록이 가장 최근 모드다. off 이면 아래 문서 규약(보드·보고 형식)을 적용하지 않는다."$'\n'
fi
# 규칙 문서에 ~/ai-board 경로가 있으면 실제 설치 경로로 바꿔 넣는다.
for f in "${files[@]}"; do
  rule="$(cat "$ROOT/rules/$f")"
  prompt+=$'\n'"${rule//'~/ai-board'/"$ROOT"}"$'\n'
done
if [[ -n "$doc" ]]; then
  prompt+=$'\n'"## 이번 세션 전용 지시 문서"$'\n'
  prompt+="다음 문서를 가장 먼저 읽고, 그 지시를 위 규칙보다 우선해 따른다: $doc"$'\n'
fi

command -v claude >/dev/null || { echo "claude 가 없습니다. $ROOT/install.sh 를 실행하세요." >&2; exit 1; }

# 진행 현황 자동 기록·보드 반영 훅 (이 런처로 시작한 세션에만 붙는다. 끄려면 AI_BOARD_HOOKS=0)
settings=()
if [[ "${AI_BOARD_HOOKS:-1}" != 0 ]] && command -v python3 >/dev/null; then
  settings=(--settings "$(python3 -c '
import json, shlex, sys
h = shlex.quote(sys.argv[1])
def e(m=None):
    d = {"hooks": [{"type": "command", "command": h, "timeout": 10}]}
    if m: d["matcher"] = m
    return [d]
print(json.dumps({"hooks": {"SessionStart": e(), "UserPromptSubmit": e(), "Notification": e(), "Stop": e(),
                            "SessionEnd": e(), "PreToolUse": e("AskUserQuestion"),
                            "PostToolUse": e("Edit|Write|MultiEdit|NotebookEdit|Bash|AskUserQuestion")}}))' "$ROOT/bin/ai-hook")")
fi
export AI_BOARD_MODE="$mode"
# 이 실행의 ID: 세션 안에서 `ai-board off` 같은 명령이 이 실행의 상태 파일을 찾는 데 쓴다 (--resume·/clear 해도 유지)
export AI_BOARD_RUN="$(date +%s)-$$"
exec claude "${settings[@]}" --append-system-prompt "$prompt" "$@"
