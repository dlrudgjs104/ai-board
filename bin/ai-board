#!/usr/bin/env python3
"""ai-board: 여러 프로젝트·여러 Claude 세션의 작업을 GitHub Projects 보드 하나에서 본다.

  ai-board            보드를 브라우저로 열기
  ai-board status     연결·로그인·대기열·최근 오류 점검
  ai-board off        이 세션의 기록을 끈다 (보드·보고 규칙 모두. 일반 claude 처럼)
  ai-board on         다시 켠다
  (claude-personal / claude-work / claude-lite 로 시작한 세션 안에서는 앞에 ! 를 붙여 실행: ! ai-board off)

카드는 claude-personal / claude-work 세션에서 훅이 자동으로 만들고 옮긴다 (전송기가 백그라운드에서 GitHub 로 보냄):
  작업 시작 → AI작업중 · 질문/권한 승인 → 판단필요 · 답변 끝 → 검토대기(+보고 코멘트) · 이슈 닫기 → 완료
카드 확인·완료·할 일 추가는 보드(웹)에서 한다. 계정·레포·보드 설정은 install.sh 로 한다 (다시 연결: ./install.sh --reconnect).
"""
import argparse
import shutil
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import aiwf  # noqa: E402
import ghboard  # noqa: E402
from ghboard import GitHubError  # noqa: E402


def die(msg):
    print(msg, file=sys.stderr)
    sys.exit(1)


def need_board():
    if not ghboard.configured():
        die(f"연결된 보드가 없습니다. 먼저: {aiwf.ROOT}/install.sh --board")


def pick():
    """연결 정보(계정 하나·레포·보드)를 불러온다."""
    name = aiwf.resolve_profile()
    return name, ghboard.use(name)


def ago(t):
    d = int(time.time() - (t or 0))
    return f"{d}초 전" if d < 60 else f"{d // 60}분 전" if d < 3600 else f"{d // 3600}시간 전" if d < 86400 else f"{d // 86400}일 전"


def is_wsl():
    try:
        return "microsoft" in Path("/proc/version").read_text().lower()
    except OSError:
        return False


def open_browser(url):
    cands = [["wslview", url], ["cmd.exe", "/c", "start", "", url], ["explorer.exe", url]] if is_wsl() else []
    for cmd in cands + [["xdg-open", url], ["open", url]]:
        if shutil.which(cmd[0]):
            subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, cwd="/")
            return True
    return False


# ---------------------------------------------------------------- 명령
def cmd_open(_):
    pick()
    need_board()
    url = ghboard.conf()["url"]
    print(f"ai-board 보드: {url}")
    if not open_browser(url):
        print("브라우저를 자동으로 열지 못했습니다. 위 주소를 여세요.")


def cmd_status(_):
    print(f"기록 저장소 : {aiwf.STATE}")
    accs = []
    if not shutil.which("gh"):
        print("GitHub CLI  : 없음 → install.sh --board")
    else:
        import boardsetup
        accs = boardsetup.accounts()
        print(f"GitHub 계정 : {', '.join(accs) or '로그인 안 됨 → gh auth login -s project'}")
    d = aiwf.profiles_conf()
    if not d["profiles"]:
        print(f"연결        : 없음 → {aiwf.ROOT}/install.sh --board")
    for n, p in d["profiles"].items():
        ghboard.use(n)
        c = ghboard.conf()
        warn = "" if p.get("login") in accs or not accs else "  ! 이 계정이 gh 에 로그인되어 있지 않음"
        print(f"계정·레포   : {p.get('login')} · {p.get('repo')}{warn}")
        print(f"보드        : {c.get('url') or '미설정'}")
        print(f"카드        : {len(ghboard.cards())}개 기록됨")
    left = ghboard.pending()
    print(f"\n대기열      : {len(left)}건{' (전송기가 자동으로 보냅니다. 계속 남으면 아래 최근 오류 확인)' if left else ''}")
    rec = aiwf.STATE / "records"
    if rec.is_dir():
        print(f"작업 일지   : 로컬 {sum(1 for _ in rec.rglob('*.md'))}개 ({rec})")
    for e in [e for e in aiwf.read_events(400) if e.get("event") in ("SyncError", "HookError")][-3:]:
        print(f"  ! 최근 오류 {ago(e['t'])}: {e['event']} {aiwf.short(e.get('detail'), 140)}")


def need_run():
    if not aiwf.run_id():
        die("claude-personal / claude-work / claude-lite 로 시작한 세션 안에서만 쓸 수 있습니다 (세션 안에서는 ! ai-board off).")


def cmd_switch(a):
    """세션 안에서 기록을 끄고 켠다. 상태는 런처 실행 단위(/clear 해도 유지)이고 다음 요청부터 적용된다."""
    need_run()
    rs = aiwf.run_state()
    cur = rs.get("mode") or aiwf.launch_mode()
    if a.cmd == "off":
        if cur != "off":
            rs["prev"] = cur
        rs["mode"] = "off"
    else:
        rs["mode"] = (rs.get("prev") or aiwf.launch_mode()) if cur == "off" else cur
    aiwf.save_run_state(rs)
    print("기록 꺼짐 (다음 요청부터 일반 claude 처럼 동작. 다시 켜려면 ai-board on)" if a.cmd == "off"
          else f"기록 켜짐: {rs['mode']} (다음 요청부터 적용)")


def main():
    ap = argparse.ArgumentParser(prog="ai-board", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd")
    for c in ("status", "off", "on"):
        sub.add_parser(c)
    a = ap.parse_args()
    {None: cmd_open, "status": cmd_status, "off": cmd_switch, "on": cmd_switch}[a.cmd](a)


if __name__ == "__main__":
    try:
        main()
    except GitHubError as e:
        die(f"GitHub 오류: {e}")
