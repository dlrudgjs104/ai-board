#!/usr/bin/env python3
"""AI Board: 여러 프로젝트·여러 Claude 세션의 작업을 GitHub Projects 보드 하나에서 본다.

  ai-board                        보드를 브라우저로 열기
  ai-board list                   터미널에서 보기 (실행 중인 세션 + 보드 카드)
  ai-board task "할 일" [-p 이름]   보드 Backlog 에 할 일 카드 추가 (나중에 세션에서 "#번호 진행해줘")
  ai-board setup <owner/repo> [--create] [--board 번호]
                                  카드(이슈)를 모을 추적 레포와 보드 설정. 레포가 없으면 --create 로 비공개 생성
  ai-board status                 설정·로그인·대기열·최근 오류 점검
  ai-board close <번호> [메모]      확인 끝: 카드를 완료로 옮기고 이슈 닫기
  ai-board title <번호|--session ID> "요청 요약 > 수정된 내용"   카드 제목 바꾸기 (푸시 뒤 훅이 안내)
  ai-board flush                  대기열에 남은 보드 작업을 지금 보내기
  ai-board archive [--days 14]    완료 후 며칠 지난 카드를 보드에서 보관 (하루 한 번 자동으로도 함)

세션 카드는 claude-personal / claude-work 세션에서 훅이 자동으로 만들고 옮긴다:
  작업 시작 → AI작업중 · 질문/권한 승인 → 판단필요 · 답변 끝 → 검토대기(+보고 코멘트) · 이슈 닫기 → 완료
"""
import argparse
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import aiwf  # noqa: E402
import ghboard  # noqa: E402
from ghboard import GitHubError  # noqa: E402


def die(msg):
    print(msg, file=sys.stderr)
    sys.exit(1)


def need_gh():
    if not shutil.which("gh"):
        die("GitHub CLI(gh) 가 없습니다. ~/ai-workflow/install.sh --board 로 설치하세요.")
    if subprocess.run(["gh", "auth", "status"], capture_output=True).returncode != 0:
        die("GitHub 로그인이 필요합니다: gh auth login -s project")


def need_board():
    if not ghboard.configured():
        die("보드가 설정되지 않았습니다. 먼저: ai-board setup <내계정>/work")


def ago(t):
    d = int(time.time() - (t or 0))
    return f"{d}초 전" if d < 60 else f"{d // 60}분 전" if d < 3600 else f"{d // 3600}시간 전" if d < 86400 else f"{d // 86400}일 전"


def is_wsl():
    try:
        return "microsoft" in Path("/proc/version").read_text().lower()
    except OSError:
        return False


def open_browser(url):
    cands = [["wslview", url], ["cmd.exe", "/c", "start", "", url], ["explorer.exe", url]] if is_wsl() else []
    for cmd in cands + [["xdg-open", url], ["open", url]]:
        if shutil.which(cmd[0]):
            subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, cwd="/")
            return True
    return False


# ---------------------------------------------------------------- 명령
def cmd_open(_):
    need_board()
    url = ghboard.conf()["url"]
    print(f"AI Board: {url}")
    if not open_browser(url):
        print("브라우저를 자동으로 열지 못했습니다. 위 주소를 여세요.")


LIVE = {"working": "⚙ 작업 중", "needs_you": "🔔 확인 필요", "replied": "✅ 답변 완료", "idle": "· 대기", "stale": "⚠ 응답 없음"}


def cmd_list(_):
    sessions = [s for s in aiwf.read_sessions() if aiwf.live_state(s) in LIVE]
    sessions.sort(key=lambda s: (s.get("project", ""), -(s.get("last_activity") or 0)))
    print("■ 실행 중인 세션")
    if not sessions:
        print("   (없음)")
    for s in sessions:
        num = ghboard.card_of(s["id"]) if ghboard.configured() else None
        print(f"   {LIVE[aiwf.live_state(s)]:<8} [{s.get('project')}] {aiwf.short(s.get('request') or '(요청 전)', 60)}"
              f"  {('#' + str(num)) if num else ''}  {ago(s.get('last_activity'))}")
        if s.get("note") and aiwf.live_state(s) == "needs_you":
            print(f"            └ {aiwf.short(s['note'], 90)}")
    if ghboard.configured():
        cards = ghboard.cards()
        for col in ghboard.COLUMNS[:-1]:
            rows = sorted(((int(n), c) for n, c in cards.items() if c.get("status") == col), reverse=True)
            if rows:
                print(f"\n■ {col}")
                for n, c in rows[:15]:
                    print(f"   #{n:<4} {aiwf.short(c.get('title'), 90)}")
        print(f"\n보드: {ghboard.conf()['url']}  (사람이 웹에서 옮기거나 닫은 카드는 여기 반영되지 않을 수 있음)")
    left = ghboard.pending()
    if left:
        print(f"\n⏳ 아직 보내지 않은 보드 작업 {len(left)}건 (ai-board flush)")


def cmd_task(a):
    need_gh(); need_board()
    if a.p:
        name = a.p
    else:
        name = aiwf.project_of(os.getcwd())[0]
    text = " ".join(a.text)
    body = (f"> 🙋 사람이 등록한 할 일 · 프로젝트 **{name}**\n\n{text}\n\n---\n"
            f"시작하려면 해당 프로젝트 폴더에서 `claude-personal` 을 켜고 `#번호 진행해줘` 처럼 요청하세요.")
    try:
        num = ghboard.create_card(name, aiwf.short(text, 70), body, status=a.status, sid="")
    except GitHubError as e:
        die(f"카드를 만들지 못했습니다: {e}")
    print(f"#{num} [{name}] {text}  → {a.status}")


def cmd_setup(a):
    need_gh()
    login = ghboard.rest("GET", "user")["login"]
    repo = a.repo if "/" in a.repo else f"{login}/{a.repo}"
    owner, rname = repo.split("/", 1)
    # 1) 추적 레포: 모든 카드(이슈)가 모이는 곳
    try:
        private = ghboard.rest("GET", f"repos/{repo}").get("private")
        print(f"추적 레포: {repo} ({'비공개' if private else '공개'})")
        if not private:
            print("  ! 공개 레포입니다. 작업 내용이 공개되니 비공개 레포를 권합니다.")
    except GitHubError as e:
        if "Not Found" not in str(e):
            die(f"추적 레포를 확인하지 못했습니다: {e}")
        if not a.create:
            if sys.stdin.isatty() and input(f"  ? {repo} 가 없습니다. 비공개 레포로 만들까요? [y/N] ").lower().startswith("y"):
                a.create = True
            else:
                die(f"추적 레포 {repo} 가 없습니다. 만들려면: ai-board setup {repo} --create")
        ghboard.rest("POST", "user/repos" if owner == login else f"orgs/{owner}/repos",
                     {"name": rname, "private": True, "auto_init": True, "description": "AI 작업 카드 (ai-workflow)"})
        print(f"추적 레포 생성: {repo} (비공개)")
    # 2) 보드: 번호를 주면 그 보드, 같은 레포로 설정된 보드가 있으면 재사용, 없으면 새로 만든다
    old = ghboard.conf()
    number, fresh = a.board, False
    if not number and old.get("repo") == repo and old.get("owner") == owner:
        number = old.get("number")
    if not number:
        r = subprocess.run(["gh", "project", "create", "--owner", owner, "--title", "AI Board", "--format", "json", "-q", ".number"],
                           capture_output=True, text=True)
        if r.returncode != 0:
            die(f"보드를 만들지 못했습니다 (project 권한 필요: gh auth refresh -s project): {r.stderr.strip()}")
        number, fresh = int(r.stdout.strip()), True
        print(f"보드 생성: #{number}")
    else:
        print(f"보드 사용: #{number}")
    p, fields = ghboard.load_board_ids(owner, int(number))
    # 3) 컬럼: 빠진 컬럼이 있으면 맞춘다. 기본 컬럼(Todo/In Progress/Done)은 ID 를 유지한 채 이름만 바꿔서
    #    GitHub 기본 자동화(Item closed → Done, Auto-close issue 등)가 그대로 '완료' 를 가리키게 한다
    st = fields.get("Status")
    have = {o["name"]: o["id"] for o in (st or {}).get("options", [])}
    missing = [c for c in ghboard.COLUMNS if c not in have]
    if missing and (fresh or a.reset_columns or set(have) <= {"Todo", "In Progress", "Done"} | set(ghboard.COLUMNS)):
        keep = {"Backlog": have.get("Backlog") or have.get("Todo"), "AI작업중": have.get("AI작업중") or have.get("In Progress"),
                "완료": have.get("완료") or have.get("Done"), "판단필요": have.get("판단필요"), "검토대기": have.get("검토대기")}
        opts = [({"id": keep[c]} if keep.get(c) else {}) | {"name": c, "color": ghboard.COLUMN_DESC[c][0],
                                                          "description": ghboard.COLUMN_DESC[c][1]} for c in ghboard.COLUMNS]
        ghboard.graphql("mutation($f:ID!,$o:[ProjectV2SingleSelectFieldOptionInput!]){updateProjectV2Field("
                        "input:{fieldId:$f,singleSelectOptions:$o}){projectV2Field{__typename}}}", f=st["id"], o=opts)
        print("컬럼 설정: " + " / ".join(ghboard.COLUMNS) + "  (Done→완료 로 이름만 바꿔 '닫으면 완료' 자동화 유지)")
    elif missing:
        print(f"  ! 보드에 없는 컬럼: {', '.join(missing)} — 웹에서 Status 옵션에 추가하거나 --reset-columns")
    if "검토필요도" not in fields:
        subprocess.run(["gh", "project", "field-create", str(number), "--owner", owner, "--name", "검토필요도",
                        "--data-type", "SINGLE_SELECT", "--single-select-options", "낮음,중간,높음"], capture_output=True)
        print("필드 추가: 검토필요도 (낮음/중간/높음)")
    if subprocess.run(["gh", "project", "link", str(number), "--owner", owner, "--repo", repo], capture_output=True).returncode == 0:
        print(f"보드를 {repo} 에 연결 (레포의 Projects 탭에 표시)")
    data = ghboard.save_board(owner, int(number), repo)
    print(f"\n보드 주소: {data['url']}")
    print("자동 설정됨: 이슈 닫힘 ↔ 완료 (GitHub 기본 자동화), 완료 후 14일 지난 카드 자동 보관(ai-board archive)")
    print("웹에서 원하면: 보기(View)를 Board 레이아웃으로, 프로젝트별 탭은 필터 label:proj:<이름> 으로 Save")


def cmd_status(_):
    c = ghboard.conf()
    print(f"기록 저장소 : {aiwf.STATE}")
    if not shutil.which("gh"):
        print("GitHub CLI  : 없음 → install.sh --board")
    else:
        ok = subprocess.run(["gh", "auth", "status"], capture_output=True, text=True)
        scopes = ok.stdout + ok.stderr
        print(f"GitHub 로그인: {'됨' if ok.returncode == 0 else '안 됨 → gh auth login -s project'}"
              f"{'' if 'project' in scopes or ok.returncode else ' (project 권한 없음 → gh auth refresh -s project)'}")
    if c.get("url"):
        print(f"보드        : {c['url']}  (추적 레포 {c['repo']})")
        print(f"카드        : {len(ghboard.cards())}개 기록됨")
    else:
        print("보드        : 미설정 → ai-board setup <내계정>/work")
    left = ghboard.pending()
    print(f"대기열      : {len(left)}건{' (ai-board flush 로 지금 보내기)' if left else ''}")
    for e in [e for e in aiwf.read_events(400) if e.get("event") in ("SyncError", "HookError")][-3:]:
        print(f"  ! 최근 오류 {ago(e['t'])}: {e['event']} {aiwf.short(e.get('detail'), 140)}")


def cmd_close(a):
    need_gh(); need_board()
    num = int(str(a.num).lstrip("#"))
    c = ghboard.conf()
    try:
        if str(num) not in ghboard.cards():
            ghboard.bind_card(num, "", aiwf.project_of(os.getcwd())[0])
        ghboard.set_status(num, "완료")
        if a.memo:
            ghboard.comment(num, " ".join(a.memo))
        ghboard.close_issue(num)
    except GitHubError as e:
        die(f"닫지 못했습니다: {e}")
    print(f"#{num} → 완료, 이슈 닫음")


def cmd_title(a):
    need_board()
    words = list(a.words)
    num = None if a.session else words.pop(0)
    text = " ".join(words).strip()
    if not text:
        die("제목이 필요합니다: ai-board title <번호> \"요청 요약 > 수정된 내용\"")
    if a.session:   # 세션 ID 로 지정: 카드가 아직 만들어지는 중이어도 대기열이 처리한다
        ghboard.enqueue(a.session, rename=text)
        ghboard.spawn_worker()
        print(f"카드 제목 변경 예약: {text}")
        return
    need_gh()
    try:
        ghboard.rename(int(num.lstrip("#")), text)
    except (GitHubError, ValueError) as e:
        die(f"제목을 바꾸지 못했습니다: {e}")
    print(f"#{num.lstrip('#')} 제목: {text}")


def cmd_archive(a):
    need_gh(); need_board()
    try:
        n = ghboard.archive_done(a.days)
    except GitHubError as e:
        die(f"보관하지 못했습니다: {e}")
    print(f"보관한 카드: {n}개 (완료 후 {a.days}일 지난 것)")


def cmd_flush(_):
    need_board()
    n = len(ghboard.pending())
    print(f"대기열 {n}건 처리 중…")
    print(ghboard.worker(foreground=True))
    left = ghboard.pending()
    if left:
        print(f"남은 작업 {len(left)}건: GitHub 한도·오류로 미뤄짐. ai-board status 로 오류를 확인하세요.")


def main():
    ap = argparse.ArgumentParser(prog="ai-board", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd")
    for c in ("open", "list", "status", "flush", "worker"):
        sub.add_parser(c)
    t = sub.add_parser("task"); t.add_argument("text", nargs="+"); t.add_argument("-p")
    t.add_argument("--status", default="Backlog", choices=ghboard.COLUMNS[:-1])
    s = sub.add_parser("setup"); s.add_argument("repo"); s.add_argument("--create", action="store_true")
    s.add_argument("--board", type=int); s.add_argument("--reset-columns", action="store_true")
    r = sub.add_parser("register"); r.add_argument("path")
    cl = sub.add_parser("close"); cl.add_argument("num"); cl.add_argument("memo", nargs="*")
    ti = sub.add_parser("title"); ti.add_argument("--session"); ti.add_argument("words", nargs="+")
    ar = sub.add_parser("archive"); ar.add_argument("--days", type=int, default=14)
    a = ap.parse_args()
    if a.cmd == "register":
        aiwf.register_project(*aiwf.project_of(os.path.abspath(a.path)))
    elif a.cmd == "worker":
        ghboard.worker()
    else:
        {"open": cmd_open, None: cmd_open, "list": cmd_list, "status": cmd_status, "flush": cmd_flush,
         "task": cmd_task, "setup": cmd_setup, "close": cmd_close, "title": cmd_title, "archive": cmd_archive}[a.cmd](a)


if __name__ == "__main__":
    try:
        main()
    except GitHubError as e:
        die(f"GitHub 오류: {e}")
