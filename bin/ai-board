#!/usr/bin/env python3
"""AI Board: 여러 프로젝트·여러 Claude 세션의 작업을 GitHub Projects 보드 하나에서 본다.

  ai-board                        보드를 브라우저로 열기
  ai-board list                   터미널에서 보기 (실행 중인 세션 + 보드 카드)
  ai-board task "할 일" [-p 이름]   보드 Backlog 에 할 일 카드 추가 (나중에 세션에서 "#번호 진행해줘")
  ai-board init [--name 이름] [--account 계정] [--repo 이름] [--board 번호|--board-title 제목] [--link 폴더] [-y]
                                  초기 설정 마법사: 계정 → 기록 레포(있으면 연결, 없으면 비공개 생성) → 보드(있으면 재사용) → 프로필
  ai-board profiles [rm 이름]      프로필(계정·레포·보드 묶음) 목록 / 연결 해제
  ai-board link <프로필> [폴더]     이 프로젝트(폴더)가 쓸 프로필 지정 (회사/개인 계정 구분)   unlink [폴더]  /  default <프로필>
  ai-board -P <프로필> <명령>       특정 프로필로 실행 (기본은 현재 폴더에 연결된 프로필)
  ai-board setup <owner/repo>     (예전 명령) init 과 같음
  ai-board status                 설정·로그인·대기열·최근 오류 점검
  ai-board close <번호> [메모]      확인 끝: 카드를 완료로 옮기고 이슈 닫기
  ai-board title <번호|--session ID> "요청 요약 > 수정된 내용"   카드 제목 바꾸기 (푸시 뒤 훅이 안내)
  ai-board flush                  대기열에 남은 보드 작업을 지금 보내기
  ai-board archive [--days 14]    완료 후 며칠 지난 카드를 보드에서 보관 (하루 한 번 자동으로도 함)

세션 중 전환 (claude-personal/work/lite 로 시작한 세션 안에서, 앞에 ! 를 붙여 실행: ! ai-board off):
  ai-board off        이 세션의 기록을 끈다 (보드·STATUS·보고 규칙 모두. 일반 claude 처럼)
  ai-board on         다시 켠다 (끄기 전 모드로)
  ai-board personal   personal 로 전환      ai-board work   work 로 전환 (모드가 바뀌면 새 카드)
  ai-board skip       다음 요청 한 건만 기록에서 제외하고 자동으로 원래대로
  ai-board now        현재 모드 확인

세션 카드는 claude-personal / claude-work 세션에서 훅이 자동으로 만들고 옮긴다:
  작업 시작 → AI작업중 · 질문/권한 승인 → 판단필요 · 답변 끝 → 검토대기(+보고 코멘트) · 이슈 닫기 → 완료
"""
import argparse
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import aiwf  # noqa: E402
import ghboard  # noqa: E402
from ghboard import GitHubError  # noqa: E402


def die(msg):
    print(msg, file=sys.stderr)
    sys.exit(1)


def need_gh():
    if not shutil.which("gh"):
        die("GitHub CLI(gh) 가 없습니다. ~/ai-workflow/install.sh --board 로 설치하세요.")
    login = ghboard.PROFILE.get("login")
    if login:
        if subprocess.run(["gh", "auth", "token", "--user", login], capture_output=True).returncode != 0:
            die(f"프로필 계정 {login} 이(가) gh 에 로그인되어 있지 않습니다: gh auth login -h github.com -s project")
    elif subprocess.run(["gh", "auth", "status"], capture_output=True).returncode != 0:
        die("GitHub 로그인이 필요합니다: gh auth login -s project")


def need_board():
    if not ghboard.configured():
        die("이 폴더에 연결된 보드가 없습니다. 먼저: ai-board init   (프로필이 있다면: ai-board link <프로필>, ai-board profiles)")


def pick(a):
    """명령이 다룰 프로필: -P 로 지정 > 현재 폴더의 연결 규칙 > 기본 프로필."""
    name = getattr(a, "profile", None) or aiwf.resolve_profile(os.getcwd())
    if getattr(a, "profile", None) and name not in aiwf.profiles_conf()["profiles"]:
        die(f"없는 프로필: {name} (ai-board profiles)")
    info = ghboard.use(name)
    return name, info


def ago(t):
    d = int(time.time() - (t or 0))
    return f"{d}초 전" if d < 60 else f"{d // 60}분 전" if d < 3600 else f"{d // 3600}시간 전" if d < 86400 else f"{d // 86400}일 전"


def is_wsl():
    try:
        return "microsoft" in Path("/proc/version").read_text().lower()
    except OSError:
        return False


def open_browser(url):
    cands = [["wslview", url], ["cmd.exe", "/c", "start", "", url], ["explorer.exe", url]] if is_wsl() else []
    for cmd in cands + [["xdg-open", url], ["open", url]]:
        if shutil.which(cmd[0]):
            subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, cwd="/")
            return True
    return False


# ---------------------------------------------------------------- 명령
def cmd_open(a):
    pick(a)
    need_board()
    url = ghboard.conf()["url"]
    print(f"AI Board: {url}")
    if not open_browser(url):
        print("브라우저를 자동으로 열지 못했습니다. 위 주소를 여세요.")


LIVE = {"working": "⚙ 작업 중", "needs_you": "🔔 확인 필요", "replied": "✅ 답변 완료", "idle": "· 대기", "stale": "⚠ 응답 없음"}


def cmd_list(_):
    sessions = [s for s in aiwf.read_sessions() if aiwf.live_state(s) in LIVE]
    sessions.sort(key=lambda s: (s.get("project", ""), -(s.get("last_activity") or 0)))
    print("■ 실행 중인 세션")
    if not sessions:
        print("   (없음)")
    for s in sessions:
        ghboard.use(s.get("profile"))
        num = ghboard.card_of(s["id"]) if ghboard.configured() else None
        print(f"   {LIVE[aiwf.live_state(s)]:<8} [{s.get('project')}] {aiwf.short(s.get('request') or '(요청 전)', 60)}"
              f"  {('#' + str(num)) if num else ''}  {ago(s.get('last_activity'))}")
        if s.get("note") and aiwf.live_state(s) == "needs_you":
            print(f"            └ {aiwf.short(s['note'], 90)}")
    names = list(aiwf.profiles_conf()["profiles"])
    for pn in names:
        ghboard.use(pn)
        if not ghboard.configured():
            continue
        cards = ghboard.cards()
        head = f"[{pn}] " if len(names) > 1 else ""
        for col in ghboard.COLUMNS[:-1]:
            rows = sorted(((int(n), c) for n, c in cards.items() if c.get("status") == col), reverse=True)
            if rows:
                print(f"\n■ {head}{col}")
                for n, c in rows[:15]:
                    print(f"   #{n:<4} {aiwf.short(c.get('title'), 90)}")
        print(f"\n{head}보드: {ghboard.conf()['url']}  (사람이 웹에서 옮기거나 닫은 카드는 여기 반영되지 않을 수 있음)")
    left = ghboard.pending()
    if left:
        print(f"\n⏳ 아직 보내지 않은 보드 작업 {len(left)}건 (ai-board flush)")


def cmd_task(a):
    pick(a)
    need_gh(); need_board()
    if a.p:
        name = a.p
    else:
        name = aiwf.project_of(os.getcwd())[0]
    text = " ".join(a.text)
    body = (f"> 🙋 사람이 등록한 할 일 · 프로젝트 **{name}**\n\n{text}\n\n---\n"
            f"시작하려면 해당 프로젝트 폴더에서 `claude-personal` 을 켜고 `#번호 진행해줘` 처럼 요청하세요.")
    try:
        num = ghboard.create_card(name, aiwf.short(text, 70), body, status=a.status, sid="")
    except GitHubError as e:
        die(f"카드를 만들지 못했습니다: {e}")
    print(f"#{num} [{name}] {text}  → {a.status}")


def cmd_init(a):
    import boardsetup
    try:
        boardsetup.run_init({"profile": a.name, "account": a.account, "repo": a.repo, "create_repo": a.create_repo,
                             "board": a.board, "board_title": a.board_title, "reset_columns": a.reset_columns,
                             "yes": a.yes, "link": a.link, "readme": a.readme, "make_default": a.make_default})
    except GitHubError as e:
        die(f"설정 중 GitHub 오류: {e}")


def cmd_setup(a):
    """예전 명령: ai-board setup <계정/레포>. init 으로 넘긴다."""
    import boardsetup
    owner = a.repo.split("/")[0] if "/" in a.repo else None
    class N: pass
    n = N()
    n.name, n.account = a.profile, (owner if owner in boardsetup.accounts() else None)
    n.repo, n.create_repo, n.board, n.board_title = a.repo, a.create, a.board, None
    n.reset_columns, n.yes, n.link, n.readme, n.make_default = a.reset_columns, False, None, False, False
    cmd_init(n)


def cmd_profiles(a):
    d = aiwf.profiles_conf()
    if a.rest[:1] == ["rm"]:
        name = (a.rest[1:2] or [None])[0]
        if name not in d["profiles"]:
            die(f"없는 프로필: {name}")
        del d["profiles"][name]
        d["rules"] = [r for r in d["rules"] if r["profile"] != name]
        if d["default"] == name:
            d["default"] = next(iter(d["profiles"]), None)
        aiwf.save_profiles(d)
        print(f"프로필 '{name}' 연결을 지웠습니다 (GitHub 의 레포·보드와 로컬 카드 기록은 그대로 남아 있음).")
        return
    if not d["profiles"]:
        print("프로필이 없습니다. 먼저: ai-board init")
        return
    here = aiwf.resolve_profile(os.getcwd())
    for n, p in d["profiles"].items():
        mark = "←  이 폴더" if n == here else ""
        print(f"{'*' if n == d['default'] else ' '} {n:<12} 계정 {p.get('login')} · 레포 {p.get('repo')} · 보드 #{p.get('board')} {p.get('board_title') or ''} {mark}")
    if d["rules"]:
        print("\n폴더 연결:")
        for r in d["rules"]:
            print(f"   {r['path']}  →  {r['profile']}")
    print("\n* = 기본 프로필 (연결 규칙이 없는 폴더에 적용). 연결: ai-board link <프로필> [폴더] · 기본 변경: ai-board default <프로필>")


def cmd_default(a):
    d = aiwf.profiles_conf()
    if a.name not in d["profiles"]:
        die(f"없는 프로필: {a.name} (ai-board profiles)")
    d["default"] = a.name
    aiwf.save_profiles(d)
    print(f"기본 프로필: {a.name}")


def cmd_link(a):
    import boardsetup
    d = aiwf.profiles_conf()
    if a.name not in d["profiles"]:
        die(f"없는 프로필: {a.name} (ai-board profiles)")
    path = a.path or aiwf.project_of(os.getcwd())[1]
    boardsetup.add_rule(d, path, a.name)
    aiwf.save_profiles(d)
    print(f"연결: {path} 아래 → 프로필 {a.name}  (이미 열려 있는 세션은 다음 세션부터 적용)")


def cmd_unlink(a):
    d = aiwf.profiles_conf()
    path = os.path.abspath(os.path.expanduser(a.path)) if a.path else aiwf.project_of(os.getcwd())[1]
    n = len(d["rules"])
    d["rules"] = [r for r in d["rules"] if os.path.abspath(os.path.expanduser(r["path"])) != path]
    aiwf.save_profiles(d)
    print("연결을 풀었습니다." if len(d["rules"]) < n else f"연결 규칙이 없습니다: {path}")


def cmd_status(_):
    print(f"기록 저장소 : {aiwf.STATE}")
    accs = []
    if not shutil.which("gh"):
        print("GitHub CLI  : 없음 → install.sh --board")
    else:
        import boardsetup
        accs = boardsetup.accounts()
        print(f"GitHub 계정 : {', '.join(accs) or '로그인 안 됨 → gh auth login -s project'}")
    d = aiwf.profiles_conf()
    if not d["profiles"]:
        print("프로필      : 없음 → ai-board init")
    for n, p in d["profiles"].items():
        ghboard.use(n)
        c = ghboard.conf()
        warn = "" if p.get("login") in accs or not accs else "  ! 이 계정이 gh 에 로그인되어 있지 않음"
        print(f"\n[프로필 {n}]{' (기본)' if n == d['default'] else ''}  계정 {p.get('login')} · 레포 {p.get('repo')}{warn}")
        print(f"  보드  : {c.get('url') or '미설정'}")
        print(f"  카드  : {len(ghboard.cards())}개 기록됨")
    left = ghboard.pending()
    print(f"\n대기열      : {len(left)}건{' (ai-board flush 로 지금 보내기)' if left else ''}")
    rec = aiwf.STATE / "records"
    if rec.is_dir():
        print(f"작업 일지   : 로컬 {sum(1 for _ in rec.rglob('*.md'))}개 ({rec})")
    for e in [e for e in aiwf.read_events(400) if e.get("event") in ("SyncError", "HookError")][-3:]:
        print(f"  ! 최근 오류 {ago(e['t'])}: {e['event']} {aiwf.short(e.get('detail'), 140)}")


def cmd_close(a):
    pick(a)
    need_gh(); need_board()
    num = int(str(a.num).lstrip("#"))
    c = ghboard.conf()
    try:
        if str(num) not in ghboard.cards():
            ghboard.bind_card(num, "", aiwf.project_of(os.getcwd())[0])
        ghboard.set_status(num, "완료")
        if a.memo:
            ghboard.comment(num, " ".join(a.memo))
        ghboard.close_issue(num)
    except GitHubError as e:
        die(f"닫지 못했습니다: {e}")
    print(f"#{num} → 완료, 이슈 닫음")


def cmd_title(a):
    if a.session:
        s = aiwf.load_json(aiwf.session_file(a.session), {})
        ghboard.use(s.get("profile") or aiwf.resolve_profile(s.get("path") or os.getcwd()))
    else:
        pick(a)
    need_board()
    words = list(a.words)
    num = None if a.session else words.pop(0)
    text = " ".join(words).strip()
    if not text:
        die("제목이 필요합니다: ai-board title <번호> \"요청 요약 > 수정된 내용\"")
    if a.session:   # 세션 ID 로 지정: 카드가 아직 만들어지는 중이어도 대기열이 처리한다
        ghboard.enqueue(a.session, rename=text)
        ghboard.spawn_worker()
        print(f"카드 제목 변경 예약: {text}")
        return
    need_gh()
    try:
        ghboard.rename(int(num.lstrip("#")), text)
    except (GitHubError, ValueError) as e:
        die(f"제목을 바꾸지 못했습니다: {e}")
    print(f"#{num.lstrip('#')} 제목: {text}")


def cmd_archive(a):
    pick(a)
    need_gh(); need_board()
    try:
        n = ghboard.archive_done(a.days)
    except GitHubError as e:
        die(f"보관하지 못했습니다: {e}")
    print(f"보관한 카드: {n}개 (완료 후 {a.days}일 지난 것)")


def need_run():
    if not aiwf.run_id():
        die("claude-personal / claude-work / claude-lite 로 시작한 세션 안에서만 쓸 수 있습니다 (세션 안에서는 ! ai-board off).")


def describe(rs):
    mode = rs.get("mode") or aiwf.launch_mode()
    base = {"off": "꺼짐 (기록·보드·STATUS 규칙 없음)", "personal": "personal (main 직접, 커밋 전 묻기)",
            "work": "work (브랜치 + PR)", "lite": "lite (지정 문서만)"}[mode]
    extra = {"next": " · 다음 요청 한 건은 기록 제외", "active": " · 지금 요청은 기록 제외 중"}.get(rs.get("skip"), "")
    return f"현재: {base}{extra}"


def cmd_switch(a):
    need_run()
    rs = aiwf.run_state()
    cur = rs.get("mode") or aiwf.launch_mode()
    launch = aiwf.launch_mode()
    if a.cmd == "off":
        if cur != "off":
            rs["prev"] = cur
        rs["mode"], rs["skip"] = "off", None
    elif a.cmd == "on":
        rs["mode"] = rs.get("prev") if cur == "off" and rs.get("prev") else (cur if cur != "off" else launch)
        rs["skip"] = None
    elif a.cmd == "skip":
        if cur == "off":
            die("이미 꺼져 있습니다. 다시 켜려면: ai-board on")
        rs["skip"] = "next"
    else:   # personal | work
        if launch == "lite":
            die("lite 세션은 off / on / skip 만 쓸 수 있습니다. personal·work 는 claude-personal / claude-work 로 시작하세요.")
        rs["mode"], rs["skip"] = a.cmd, None
    rs["mode"] = rs.get("mode") or launch
    aiwf.save_run_state(rs)
    print(describe(rs) + ("   (다음 요청부터 적용)" if a.cmd != "now" else ""))


def cmd_now(_):
    need_run()
    print(describe(aiwf.run_state()))


def cmd_flush(_):
    n = len(ghboard.pending())
    print(f"대기열 {n}건 처리 중…")
    print(ghboard.worker(foreground=True))
    left = ghboard.pending()
    if left:
        print(f"남은 작업 {len(left)}건: GitHub 한도·오류로 미뤄짐. ai-board status 로 오류를 확인하세요.")


def main():
    ap = argparse.ArgumentParser(prog="ai-board", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("-P", "--profile", help="다룰 프로필 (기본: 현재 폴더에 연결된 프로필 → 기본 프로필)")
    sub = ap.add_subparsers(dest="cmd")
    for c in ("open", "list", "status", "flush", "worker"):
        sub.add_parser(c)
    ini = sub.add_parser("init", help="초기 설정: 계정 → 기록 레포 → 보드 → 프로필")
    ini.add_argument("--name", help="프로필 이름"); ini.add_argument("--account", help="사용할 GitHub 계정 (gh 로그인된 계정)")
    ini.add_argument("--repo", help="기록 레포 (이름 또는 owner/이름). 있으면 연결, 없으면 --create-repo 로 비공개 생성")
    ini.add_argument("--create-repo", action="store_true"); ini.add_argument("--board", type=int, help="기존 보드 번호")
    ini.add_argument("--board-title", help="보드 이름 (같은 이름이 있으면 재사용, 없으면 새로 만듦)")
    ini.add_argument("--reset-columns", action="store_true"); ini.add_argument("--yes", "-y", action="store_true", help="묻지 않고 기본값")
    ini.add_argument("--link", help="이 프로필을 적용할 프로젝트(상위) 폴더"); ini.add_argument("--readme", action="store_true", help="레포 설명서를 최신으로 덮어쓰기")
    ini.add_argument("--make-default", action="store_true", help="기본 프로필로 지정")
    pr = sub.add_parser("profiles"); pr.add_argument("rest", nargs="*")
    df = sub.add_parser("default"); df.add_argument("name")
    lk = sub.add_parser("link"); lk.add_argument("name"); lk.add_argument("path", nargs="?")
    ul = sub.add_parser("unlink"); ul.add_argument("path", nargs="?")
    t = sub.add_parser("task"); t.add_argument("text", nargs="+"); t.add_argument("-p")
    t.add_argument("--status", default="Backlog", choices=ghboard.COLUMNS[:-1])
    s = sub.add_parser("setup"); s.add_argument("repo"); s.add_argument("--create", action="store_true")
    s.add_argument("--board", type=int); s.add_argument("--reset-columns", action="store_true")
    for c in ("off", "on", "personal", "work", "skip"):
        sub.add_parser(c)
    sub.add_parser("now")
    r = sub.add_parser("register"); r.add_argument("path")
    cl = sub.add_parser("close"); cl.add_argument("num"); cl.add_argument("memo", nargs="*")
    ti = sub.add_parser("title"); ti.add_argument("--session"); ti.add_argument("words", nargs="+")
    ar = sub.add_parser("archive"); ar.add_argument("--days", type=int, default=14)
    a = ap.parse_args()
    if a.cmd == "register":
        aiwf.register_project(*aiwf.project_of(os.path.abspath(a.path)))
    elif a.cmd == "worker":
        ghboard.worker()
    else:
        {"open": cmd_open, None: cmd_open, "list": cmd_list, "status": cmd_status, "flush": cmd_flush,
         "off": cmd_switch, "on": cmd_switch, "personal": cmd_switch, "work": cmd_switch, "skip": cmd_switch, "now": cmd_now,
         "init": cmd_init, "profiles": cmd_profiles, "default": cmd_default, "link": cmd_link, "unlink": cmd_unlink,
         "task": cmd_task, "setup": cmd_setup, "close": cmd_close, "title": cmd_title, "archive": cmd_archive}[a.cmd](a)


if __name__ == "__main__":
    try:
        main()
    except GitHubError as e:
        die(f"GitHub 오류: {e}")
