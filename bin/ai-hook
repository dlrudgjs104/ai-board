#!/usr/bin/env python3
"""Claude Code 훅 처리기. claude-personal / claude-work / claude-lite 로 시작한 세션에만 런처가 붙인다.

하는 일
- 세션 활동(요청, 파일 수정, 커밋, 질문, 답변 완료, 종료)을 ~/.ai-workflow 에 기록한다
- GitHub Projects 보드 작업을 대기열에 넣고 전송기를 깨운다 (보드가 설정된 personal/work 세션)
    작업 시작 → 카드 생성·AI작업중 / 질문·권한 승인 → 판단필요 / 답변 끝 → 검토대기 + 보고 코멘트
    카드는 파일 수정·커밋·질문·1분 넘는 작업이 있을 때만 만든다 (간단한 질문 세션은 보드에 안 올림)
- SessionStart: 이 프로젝트의 열린 카드, 최근 세션, 동시에 실행 중인 세션을 Claude 에게 알려 준다
- 모드: 런처가 정한 모드(personal / work / lite)로 동작하고, 세션 중 `ai-board off|on` 으로 끄고 켤 수 있다.
    모드별 규칙(personal.md / work.md)은 요청 때마다 이 훅이 넣어 준다. off 이면 기록·보드를 모두 건너뛴다
훅이 실패해도 Claude 작업은 막지 않는다.
"""
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import aiwf  # noqa: E402
import ghboard  # noqa: E402
import journal  # noqa: E402
from redact import redact  # noqa: E402

EDIT_TOOLS = ("Edit", "Write", "MultiEdit", "NotebookEdit")


OFF_NOTE = ("[ai-workflow] 이 세션은 지금 워크플로우가 꺼져 있다 (ai-board on 으로 다시 켠다). 보드·보고 형식 규칙을 "
            "적용하지 않고 일반 claude 처럼 작업한다. 시크릿 금지와 되돌리기 어려운 작업의 사전 확인은 유지한다.")



def mode_context(rs, mode):
    """요청마다 Claude 에게 넣어 줄 현재 모드 규칙. 모드가 처음이거나 바뀌었으면 규칙 전문, 아니면 한 줄 요약."""
    if mode == "lite":
        return ""       # lite 규칙은 시작할 때 시스템 프롬프트에 들어가 있다
    try:
        text = (aiwf.ROOT / "rules" / f"{mode}.md").read_text(encoding="utf-8").replace("~/ai-workflow", str(aiwf.ROOT))
    except OSError:
        return ""
    if rs.get("injected") == mode:
        m = re.search(r"^> 요약:\s*(.+)$", text, re.M)
        return f"[ai-workflow 현재 모드: {mode}] {m.group(1)}" if m else ""
    head = f"[ai-workflow 현재 모드: {mode}]"
    rs["injected"] = mode
    aiwf.save_run_state(rs)
    return head + "\n\n" + text


def git(path, *args):
    try:
        r = subprocess.run(["git", "-C", path, *args], capture_output=True, text=True, timeout=3)
        return r.stdout.strip() if r.returncode == 0 else ""
    except (OSError, subprocess.TimeoutExpired):
        return ""


def rel(path, root):
    try:
        return str(Path(path).resolve().relative_to(root))
    except (ValueError, OSError):
        return path


def hm(t):
    return time.strftime("%m-%d %H:%M", time.localtime(t or 0))


def looks_question(msg):
    """답변이 사용자에게 결정을 묻고 끝나는지 (마지막 줄이 질문)."""
    lines = [re.sub(r"[*_`>#\s]+$|^[*_`>#\-\s]+", "", l) for l in (msg or "").strip().splitlines() if l.strip()]
    return bool(lines) and (lines[-1].endswith("?") or lines[-1].endswith("까요") or lines[-1].endswith("까요."))


def review_level(msg):
    m = re.findall(r"검토\s*필요도[^가-힣]{0,6}(낮음|중간|높음)", msg or "")
    return m[-1] if m else None


def opening_request(s, card):
    """현재 카드를 연 요청의 글. 카드가 아직 없으면 지금 요청."""
    reqs = s.get("requests") or []
    since = (ghboard.cards().get(str(card), {}) if card else {}).get("opened_t") or 0
    hit = next((r for r in reqs if r["t"] >= since), None) if since else None
    return (hit or (reqs[-1] if reqs else {})).get("text") or s.get("request")


def fetched_recently(path, secs=600):
    """최근 secs 초 안에 fetch 했으면 True. 세션을 열 때마다 네트워크를 기다리지 않게 한다 (느리거나 끊긴 네트워크에서 시작 지연 방지)."""
    fh = git(path, "rev-parse", "--git-path", "FETCH_HEAD")
    try:
        return bool(fh) and time.time() - (Path(path) / fh).stat().st_mtime < secs
    except OSError:
        return False


def remote_note(path):
    """다른 PC 에서 작업했을 수 있으니 원격과의 차이와 작업 중인 변경을 알려 준다 (fetch 만 하고 pull 은 하지 않는다)."""
    if not aiwf.is_repo(path) or not git(path, "remote"):
        return []
    if not fetched_recently(path):
        try:
            subprocess.run(["git", "-C", path, "fetch", "--quiet"], capture_output=True, timeout=5,
                           env={**os.environ, "GIT_TERMINAL_PROMPT": "0"})
        except (OSError, subprocess.TimeoutExpired):
            pass
    out = []
    counts = git(path, "rev-list", "--left-right", "--count", "HEAD...@{u}")
    if counts:
        ahead, behind = (int(x) for x in counts.split())
        if behind:
            out.append(f"⚠ 원격에 아직 받지 않은 커밋 {behind}개 (다른 PC 에서 올렸을 수 있음). 작업 전에 사용자에게 알리고 pull 할지 묻는다. 임의로 pull·merge 하지 않는다.")
        if ahead:
            out.append(f"원격에 올리지 않은 로컬 커밋 {ahead}개")
    dirty = [l for l in git(path, "status", "--porcelain").splitlines() if l.strip()]
    if dirty:
        out.append(f"커밋하지 않은 변경 {len(dirty)}개 (이전 세션의 작업일 수 있음)")
    if not out and counts:
        out.append("원격과 동기화됨")
    return ["git: " + x for x in out] if out else []


def brief(s, name, path):
    """세션 시작 때 Claude 에게 넣어 줄 요약."""
    out = [f"[ai-workflow] 프로젝트 '{name}' 의 지금까지 상황 (자동 생성 요약)"]
    if ghboard.configured():
        mine = sorted(((int(n), c) for n, c in ghboard.cards().items()
                       if c.get("project") == name and c.get("status") not in ("완료", None)), reverse=True)[:10]
        if mine:
            out.append("보드의 이 프로젝트 카드 (최근, 사람이 이미 닫았을 수 있음):")
            out += [f"  - #{n} [{c.get('status')}] {aiwf.short(c.get('title'), 100)}" for n, c in mine]
    out += remote_note(path)
    others = [x for x in aiwf.read_sessions() if x.get("path") == path and x.get("id") != s["id"]]
    live = [x for x in others if aiwf.live_state(x) in ("working", "needs_you")]
    if live:
        out.append(f"⚠ 같은 프로젝트에서 지금 작업 중인 다른 세션 {len(live)}개 — 같은 파일을 동시에 고치지 않게 주의하고, 겹치면 사용자에게 알린다:")
        out += [f"  - [{aiwf.live_state(x)}] {aiwf.short(x.get('request') or '(요청 전)', 120)}" for x in live]
    done = sorted([x for x in others if x not in live and x.get("request")],
                  key=lambda x: x.get("last_activity", 0), reverse=True)[:3]
    if done:
        out.append("최근 세션:")
        out += [f"  - {hm(x.get('last_activity'))} 요청: {aiwf.short(x.get('request'), 100)} → "
                f"{aiwf.short(x.get('summary') or '(요약 없음)', 160)}" for x in done]
    return "\n".join(out)


def guide(mode, name, path):
    """세션을 새로 시작했을 때 사용자 화면에 보여 줄 시작 안내 (명령어 + 처음에 할 일)."""
    label = {"personal": "personal · main 직접 작업, 커밋 전에 묻기", "work": "work · 브랜치 + PR, 병합은 사람", "lite": "lite · 지정 문서만"}[mode]
    L = [f"━━ ai-workflow 시작 안내  [{label}] ━━", "", (f"프로젝트: {name}" if aiwf.is_repo(path) else f"시작 폴더: {path} (프로젝트는 요청에서 정해집니다)"), ""]
    if mode != "lite":
        board = ghboard.configured()
        if aiwf.is_repo(path):
            first = f'  1. "{name} 프로젝트 파악해줘" 처럼 요청하면 구조·최근 작업을 읽고 현황을 정리합니다.'
        else:
            first = ('  1. 여기는 프로젝트 폴더가 아니라서, 작업할 프로젝트의 폴더 이름을 넣어 요청하세요. 예: "coinsensor 프로젝트 파악해줘"\n'
                     '     (이 폴더 아래의 프로젝트를 찾아 그 프로젝트의 작업으로 기록하고, 구조·최근 작업을 정리합니다)')
        L += ["▶ 처음에는 이렇게 시작하세요", first,
              "  2. 이어서 할 일을 요청합니다. 20초 넘게 걸리는 작업은 보드에 카드가 생기고 진행됩니다.",
              "  3. 끝나면 보고를 확인하고, 이상 없으면 카드를 완료 처리하세요. (\"확인 완료\" 라고 말하면 닫습니다)"]
        if not board:
            L.append(f"  ※ GitHub 보드가 아직 연결되지 않았습니다. 기록·보드를 쓰려면 터미널에서: {aiwf.ROOT}/install.sh --board")
        L += ["", "▶ 이 세션에서 쓸 수 있는 명령 (앞에 ! 를 붙여 실행)",
              "  ! ai-board            보드를 브라우저로 열기       ! ai-board status   연결·대기열 점검",
              "  ! ai-board off / on   이 세션 기록 끄기·켜기",
              "  (카드는 훅이 자동으로 만들고 옮깁니다. 확인이 끝나면 보드에서 이슈를 닫으면 완료가 됩니다)",
              "", "▶ 기록 위치",
              "  · 요청·답변·진행 과정 전체: 작업 일지 (기록 레포 records/ + ~/.ai-workflow/records/)",
              "  · 요청별 진행 상황: GitHub 보드(AI Board)의 카드. 사람 판단이 필요하면 판단필요로 이동합니다."]
    else:
        L += ["지정한 문서만 읽고 작업합니다. 기록·보드 규칙은 적용되지 않습니다.",
              "  ! ai-board off / on   기록 끄기·켜기"]
    L += ["", "※ 이 안내는 새로 시작할 때만 나옵니다. 그냥 claude 로 시작한 세션에는 워크플로우가 적용되지 않습니다."]
    return "\n".join(L)


def main():
    try:
        data = json.load(sys.stdin)
    except ValueError:
        return 0
    event = data.get("hook_event_name", "")
    sid = data.get("session_id") or "unknown"
    cwd = data.get("cwd") or os.getcwd()
    aiwf.ensure_dirs()
    f = aiwf.session_file(sid)
    s = aiwf.load_json(f, None)
    s_loaded = bool(s)
    # 모드: ai-board off|on 으로 세션 중에 끄고 켠다 (런처 실행별 상태 파일)
    rs = aiwf.run_state()
    if event == "SessionStart":
        aiwf.prune_runs()
        aiwf.prune_sessions()
        rs["injected"] = None       # 새 세션·--resume·/clear·압축 뒤에는 모드 규칙을 다시 넣어 준다
        aiwf.save_run_state(rs)
    mode = aiwf.effective_mode(rs)
    if mode == "off":
        # 기록·보드 규칙을 모두 건너뛴다. 요청 내용도 저장하지 않는다
        if event == "UserPromptSubmit" and rs.get("injected") != "off":
            rs["injected"] = "off"
            aiwf.save_run_state(rs)
            print(OFF_NOTE)
        if s_loaded and s.get("last_eff") != "off":
            # 작업 도중 껐으면 열려 있던 카드를 검토대기로 정리한다
            ghboard.use(s.get("profile") or aiwf.resolve_profile(s.get("path") or cwd))
            card = ghboard.card_of(sid) if ghboard.configured() else None
            if card and s.get("state") == "working":
                ghboard.enqueue(sid, status="검토대기", body=True, final=True)
                ghboard.spawn_worker()
            if s.get("state") in ("working", "needs_you"):
                s["state"] = "idle"
            s["last_eff"] = "off"
            aiwf.save_json(f, s)
        return 0
    if not s:
        name, path = aiwf.project_of(cwd)
        s = {"id": sid, "project": name, "path": path, "mode": mode, "started": aiwf.now(), "jid": journal.new_jid(), "state": "idle",
             "request": "", "requests": [], "files": [], "commits": [], "tools": 0, "last_tool": "",
             "summary": "", "note": "", "branch": ""}
    name, path = s["project"], s["path"]
    prof = s.get("profile") or aiwf.resolve_profile(path)      # 이 프로젝트의 기록 레포·보드 (프로필)
    ghboard.use(prof)
    s["profile"] = prof
    s.update(mode=mode, launch_mode=aiwf.launch_mode(), last_eff=mode)
    board = mode != "lite" and ghboard.configured()
    card = ghboard.card_of(sid) if board else None
    ops = None          # 보드 대기열에 넣을 작업
    jpush = False       # 일지를 기록 레포에 올릴지
    detail, out = "", None     # out: 세션 시작·요청 때 Claude 에게 넣어 줄 문맥

    if event == "SessionStart":
        aiwf.register_project(name, path)
        s["state"] = "idle"
        s["branch"] = git(path, "branch", "--show-current")
        detail = data.get("source", "")
        out = brief(s, name, path)

    elif event == "UserPromptSubmit":
        prompt = redact((data.get("prompt") or "").strip())
        slash = bool(re.match(r"^/[A-Za-z][\w:-]*(\s|$)", prompt))     # /compact 같은 명령 (경로 /tmp/... 는 아님)
        if prompt and not slash:
            s["request"] = aiwf.short(prompt, 400)
            s["requests"] = (s.get("requests") or [])[-29:] + [{"t": aiwf.now(), "text": aiwf.short(prompt, 400)}]
            if mode != "lite":
                journal.new_turn(s, prompt, mode)
        s.update(state="working", turn_started=aiwf.now(), turn_files=[], turn_commits=0, note="")
        detail = aiwf.short(prompt, 200)
        notes = []
        ctx = mode_context(rs, mode)
        if ctx:
            notes.append(ctx)
        if not aiwf.is_repo(path) and not card and prompt:
            # 홈처럼 레포가 아닌 곳에서 시작한 세션: 요청에 적힌 프로젝트 이름으로 기록한다 ("coinsensor 프로젝트에서 …")
            hit = aiwf.project_in_text(prompt, cwd)
            if hit:
                s["project"], s["path"] = name, path = hit
                s["profile"] = aiwf.resolve_profile(path)
                ghboard.use(s["profile"])
                board = mode != "lite" and ghboard.configured()
                s["branch"] = git(path, "branch", "--show-current")
                notes.append(f"[ai-workflow] 이 세션은 프로젝트 '{name}' ({path}) 작업으로 기록된다. 작업은 이 경로에서 한다.")
        # "#12 진행해줘", "카드 #12" 처럼 보드에 미리 만든 카드를 지정하면 그 카드로 연결
        m = re.match(r"^\s*#(\d{1,6})\b", prompt) or re.search(r"카드\s*#(\d{1,6})", prompt)
        if board and m:
            ops = {"bind": int(m.group(1)), "status": "AI작업중", "body": True}
        elif board and card:
            # 현재 카드가 열려 있으면 이어 쓰고(검토대기·판단필요 → AI작업중), 완료·닫힘이면 전송기가 새 카드를 만든다
            ops = {"status": "AI작업중", "body": True}
            if prompt and not slash:
                ops.update(create=True, fresh=True)
        elif board and aiwf.is_repo(path) and prompt and not slash:
            # 20초 뒤에도 작업 중이면 카드를 만든다. 그 전에 답이 끝나면 취소 (간단한 질문은 보드에 안 올림)
            ops = {"create": True, "status": "AI작업중", "body": True, "tentative": True, "delay": 20}
        out = "\n".join(notes) or None

    elif event == "PreToolUse" and data.get("tool_name") == "AskUserQuestion":
        qs = (data.get("tool_input") or {}).get("questions") or []
        text = redact("\n".join(f"- {q.get('question', '')}" + "".join(f"\n  - {o.get('label', '')}: {o.get('description', '')}"
                                                                      for o in q.get("options", [])) for q in qs))
        s["pending_q"] = redact(" / ".join(q.get("question", "") for q in qs))
        s["state"], s["note"] = "needs_you", aiwf.short(redact(" / ".join(q.get("question", "") for q in qs)), 200)
        detail = s["note"]
        event = "Question"
        if board:
            ops = {"create": True, "status": "판단필요", "body": True,
                   "comments": [f"### ❓ 확인이 필요합니다\n\n{aiwf.short_lines(text, 3000)}"]}

    elif event == "PostToolUse":
        tool, ti = data.get("tool_name", ""), data.get("tool_input") or {}
        s["state"] = "working"
        s["tools"] = s.get("tools", 0) + 1
        if tool in EDIT_TOOLS:
            raw = ti.get("file_path") or ti.get("notebook_path") or ""
            if raw and not aiwf.is_repo(path) and not card:
                # 홈 폴더처럼 레포가 아닌 곳에서 시작한 세션: 처음 고친 파일의 레포를 프로젝트로 삼는다
                fname, fpath = aiwf.project_of(str(Path(raw).parent))
                if aiwf.is_repo(fpath):
                    s["project"], s["path"] = name, path = fname, fpath
                    s["profile"] = aiwf.resolve_profile(path)
                    ghboard.use(s["profile"])
                    board = mode != "lite" and ghboard.configured()
                    aiwf.register_project(name, path)
            fp = rel(raw, path)
            s["last_tool"] = f"수정 {fp}"
            s["file_t"] = dict(list({**(s.get("file_t") or {}), fp: aiwf.now()}.items())[-200:])
            for key in ("files", "turn_files"):
                lst = s.get(key) or []
                if fp not in lst:
                    lst.append(fp)
                s[key] = lst[-200:]
            detail = s["last_tool"]
            journal.add_file(s, fp)
            if board:
                ops = {"body": True} if card else {"create": True, "status": "AI작업중", "body": True}
        elif tool == "Bash":
            cmd = ti.get("command", "")
            s["last_tool"] = "실행 " + redact(aiwf.short(cmd, 80))
            if re.search(r"\bgit\b.*\bcommit\b", cmd):
                c = git(path, "log", "-1", "--format=%h %s")
                if c and c not in (s.get("commits") or []):
                    s["commits"] = (s.get("commits") or [])[-49:] + [c]
                    s["commit_t"] = {**(s.get("commit_t") or {}), c: aiwf.now()}
                    s["turn_commits"] = s.get("turn_commits", 0) + 1
                    journal.add_commit(s, c)
                    s["pushed_commits"] = (s.get("pushed_commits") or []) + [c.split(" ", 1)[-1]]
                    detail, event = "커밋 " + c, "Commit"
                    if board:
                        ops = {"body": True} if card else {"create": True, "status": "AI작업중", "body": True}
            resp = json.dumps(data.get("tool_response") or "", ensure_ascii=False)
            if re.search(r"\bgit\b.*\bpush\b", cmd) and not re.search(r"rejected|error:|fatal:", resp):
                s["pushed"], s["renamed"] = True, False
                detail, event = "푸시 " + redact(aiwf.short(cmd, 60)), "Push"
                if board:
                    ops = ops or {"body": True}
        elif tool == "AskUserQuestion":
            s["note"] = ""
            ans = data.get("tool_response")
            ans = ans.get("answers", ans) if isinstance(ans, dict) else ans
            journal.add_decision(s, f"{aiwf.short(s.pop('pending_q', ''), 160)} → "
                                    f"{aiwf.short(json.dumps(ans, ensure_ascii=False) if not isinstance(ans, str) else ans, 240)}")
            if board and card:
                ops = {"status": "AI작업중"}
        if not detail and not ops:
            aiwf.save_json(f, {**s, "last_activity": aiwf.now()})
            return 0    # 일반 도구 실행은 활동 시각만 갱신

    elif event == "Notification":
        msg = redact(data.get("message", ""))
        if re.search(r"permission|권한|승인", msg, re.I):   # 권한 승인 대기만 '판단필요'로 (단순 입력 대기는 무시)
            s["state"], s["note"] = "needs_you", aiwf.short(msg, 200)
            detail = s["note"]
            if board:
                ops = {"create": True, "status": "판단필요"}
        else:
            aiwf.save_json(f, s)
            return 0

    elif event == "Stop":
        msg = redact(data.get("last_assistant_message") or "")
        s["summary"] = aiwf.short_lines(msg, 3000)
        if mode != "lite":
            journal.finish_turn(s, msg, data.get("transcript_path"))
            journal.write_local(s)
            jpush = True
        q = looks_question(msg)
        s["state"] = "needs_you" if q else "replied"
        s["note"] = aiwf.short(msg.strip().splitlines()[-1], 200) if q and msg.strip() else ""
        detail = aiwf.short(msg, 200)
        worked = bool(s.get("turn_files") or s.get("turn_commits"))
        # 레포가 아닌 폴더(홈 등)에서 시작해 아직 고친 파일이 없으면 프로젝트를 알 수 없으므로 카드를 만들지 않는다
        long_turn = aiwf.now() - s.get("turn_started", aiwf.now()) > 60 and aiwf.is_repo(path)
        pushed_now = bool(s.get("pushed"))
        if board and s.get("pushed") and not s.get("renamed"):
            # AI가 제목을 안 바꿨으면 '첫 요청 > 이번에 푸시한 커밋' 으로 바꾼다
            first = opening_request(s, card) or "작업"
            done = " · ".join(dict.fromkeys(s.get("pushed_commits") or [])) or "푸시함"
            ghboard.enqueue(sid, rename=f"{aiwf.short(first, 40)} > {aiwf.short(done, 60)}")
            s["renamed"] = True
        if s.get("pushed"):
            s["pushed"], s["pushed_commits"] = False, []
        if board and not (card or worked or long_turn):
            ghboard.cancel_tentative(sid)
        if board and (card or worked or long_turn):
            # personal 모드에서 커밋·푸시까지 했으면 그 작업은 끝난 것이므로 완료 처리 (work 는 PR 검토가 남아 검토대기).
            # 푸시 뒤 마지막 줄의 질문("확인할까요?")은 다음 작업 제안이라 완료를 막지 않고 보고 코멘트에만 남긴다
            done = pushed_now and mode == "personal"
            if done:
                q = False
            head = "### ❓ 확인이 필요합니다" if q else "### ✅ 작업 보고"
            ops = {"create": True, "status": "완료" if done else ("판단필요" if q else "검토대기"),
                   "review": review_level(msg), "body": True, "final": True, "close": done,
                   "comments": [f"{head}\n\n{aiwf.short_lines(msg, 4000)}"] if (worked or q or pushed_now) else []}

    elif event == "SessionEnd":
        s["state"] = "ended"
        detail = data.get("reason", "")
        if mode != "lite" and journal.turns(s):
            journal.write_local(s)
            jpush = True
        if board and card:
            ops = {"body": True, "final": True}

    if jpush and ghboard.configured():
        ops = {**(ops or {}), "journal": True}
    s["last_activity"] = aiwf.now()
    aiwf.save_json(f, s)
    aiwf.append_event({"t": s["last_activity"], "sid": sid, "project": name, "path": path, "event": event, "detail": detail})
    if ops:
        first = s.get("request")        # 카드가 새로 만들어질 때의 제목: 지금 요청
        ghboard.enqueue(sid, title=first, **ops)
        ghboard.spawn_worker()
    if out:
        if event == "SessionStart" and data.get("source") == "startup":
            # 사용자 화면에 시작 안내(systemMessage), Claude 에게는 현황 요약(additionalContext)
            print(json.dumps({"systemMessage": guide(mode, name, path),
                              "hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": out}}, ensure_ascii=False))
        else:
            print(out)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as e:  # 훅 오류로 세션을 막지 않는다
        try:
            aiwf.append_event({"t": aiwf.now(), "event": "HookError", "detail": repr(e)[:300]})
        except Exception:
            pass
        sys.exit(0)
