#!/usr/bin/env python3
"""여러 프로젝트의 docs/STATUS.md 를 모아 한 화면으로 보여준다.

사용:
  ai-status              🔴 → 🟡 → 🟢 순으로 모든 프로젝트 요약
  ai-status -r           🔴(사람 판단 필요)만
  ai-status -p NAME      프로젝트 이름에 NAME 이 포함된 것만
  ai-status --root DIR   검색 시작 위치 (기본: ~)  / --depth N (기본 4)
"""
import argparse, os, re, sys, time
from pathlib import Path

SKIP = {"node_modules", ".git", ".cache", ".nvm", ".local", ".npm", ".gradle", ".m2",
        "__pycache__", "build", "dist", "target", ".venv", "venv", "backups", "tomcat9"}
SECTIONS = [("🔴", "사람 판단 필요"), ("🟡", "진행 중"), ("🟢", "검토 대기"), ("⚪", "다음 예정")]
STALE_DAYS = 3


def find_status_files(root: Path, depth: int):
    root_depth = len(root.parts)
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [d for d in dirnames if d not in SKIP and not d.startswith(".")]
        if len(Path(dirpath).parts) - root_depth >= depth:
            dirnames[:] = []
        if Path(dirpath).name == "docs" and "STATUS.md" in filenames:
            yield Path(dirpath) / "STATUS.md"


def parse(path: Path):
    text = path.read_text(encoding="utf-8", errors="replace")
    m = re.search(r"^최종 갱신:\s*(\d{4}-\d{2}-\d{2})(?:\s+(\d{2}:\d{2}))?", text, re.M)
    updated = m.group(0).split(":", 1)[1].strip() if m else None
    sections = {e: [] for e, _ in SECTIONS}
    cur = None
    for line in text.splitlines():
        h = re.match(r"^##\s+(\S+)", line)
        if h:
            cur = h.group(1) if h.group(1) in sections else None
            continue
        if cur and re.match(r"^\s*-\s+", line):
            item = re.sub(r"^\s*-\s+(\[[ xX]\]\s*)?", "", line).strip()
            if item and item != "(없음)":
                sections[cur].append(item)
    return updated, sections


def project_name(status: Path) -> str:
    proj = status.parent.parent
    return proj.name


def age_days(updated):
    if not updated:
        return None
    try:
        t = time.mktime(time.strptime(updated.split()[0], "%Y-%m-%d"))
        return int((time.time() - t) // 86400)
    except ValueError:
        return None


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("-r", "--red-only", action="store_true")
    ap.add_argument("-p", "--project")
    ap.add_argument("--root", default=str(Path.home()))
    ap.add_argument("--depth", type=int, default=4)
    a = ap.parse_args()

    rows = []
    for f in sorted(set(find_status_files(Path(a.root).expanduser(), a.depth))):
        name = project_name(f)
        if a.project and a.project.lower() not in name.lower():
            continue
        updated, sections = parse(f)
        rows.append((name, f, updated, sections))

    if not rows:
        print("STATUS.md 를 가진 프로젝트가 없습니다. `ai-init <프로젝트 경로>` 로 만들 수 있습니다.")
        return 0

    emojis = ["🔴"] if a.red_only else ["🔴", "🟡", "🟢"]
    total = {e: sum(len(r[3][e]) for r in rows) for e, _ in SECTIONS}
    print(f"프로젝트 {len(rows)}개  |  🔴 {total['🔴']}  🟡 {total['🟡']}  🟢 {total['🟢']}  ⚪ {total['⚪']}\n")

    for e in emojis:
        label = dict(SECTIONS)[e]
        hits = [(n, f, u, s) for n, f, u, s in rows if s[e]]
        if not hits:
            if e == "🔴":
                print(f"{e} {label}: 없음\n")
            continue
        print(f"{e} {label}")
        for name, f, updated, s in hits:
            for item in s[e]:
                print(f"  [{name}] {item}")
        print()

    stale = [(n, age_days(u)) for n, f, u, s in rows if (age_days(u) or 0) >= STALE_DAYS]
    nodate = [n for n, f, u, s in rows if age_days(u) is None]
    if stale or nodate:
        print("⏱ 갱신 확인 필요")
        for n, d in stale:
            print(f"  [{n}] {d}일 전 갱신")
        for n in nodate:
            print(f"  [{n}] 최종 갱신 날짜 없음")
    return 0


if __name__ == "__main__":
    sys.exit(main())
