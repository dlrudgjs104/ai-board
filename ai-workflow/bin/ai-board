#!/usr/bin/env bash
# GitHub Projects 단일 보드("AI Board") 보조 명령. gh CLI 필요 (설정: github-projects/SETUP.md).
#   ai-board setup                       보드 생성 + 번호 저장 (Status 옵션 이름 변경은 웹에서 1회 수동)
#   ai-board add <owner/repo> 제목 [본문]  이슈 생성 + 보드 추가 (Backlog)
#   ai-board move <이슈URL> <상태>         상태: Backlog | AI작업중 | 판단필요 | 검토대기 | 완료
#   ai-board list                        보드 항목 목록
#   ai-board link <owner/repo>           기존 레포를 보드에 연결 (보드 화면에서 레포 선택용)
set -euo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
CONF="$ROOT/.board"          # BOARD_OWNER, BOARD_NUMBER (gitignore 대상)
TITLE="AI Board"

command -v gh >/dev/null || { echo "gh 가 없습니다. $ROOT/github-projects/SETUP.md 의 1~2단계를 먼저 하세요." >&2; exit 1; }
[[ -f "$CONF" ]] && source "$CONF"
OWNER="${BOARD_OWNER:-@me}"

need_board() { [[ -n "${BOARD_NUMBER:-}" ]] || { echo "보드가 설정되지 않았습니다. 먼저: ai-board setup" >&2; exit 1; }; }

cmd="${1:-}"; shift || true
case "$cmd" in
  setup)
    if [[ -n "${BOARD_NUMBER:-}" ]]; then echo "이미 설정됨: owner=$OWNER number=$BOARD_NUMBER"; exit 0; fi
    out="$(gh project create --owner "$OWNER" --title "$TITLE" --format json)"
    num="$(printf '%s' "$out" | python3 -c 'import sys,json; print(json.load(sys.stdin)["number"])')"
    printf 'BOARD_OWNER=%s\nBOARD_NUMBER=%s\n' "$OWNER" "$num" > "$CONF"
    gh project field-create "$num" --owner "$OWNER" --name "검토필요도" --data-type SINGLE_SELECT \
      --single-select-options "낮음,중간,높음" >/dev/null
    echo "보드 생성됨 (number=$num). 이제 웹에서 Status 옵션 이름을 아래로 바꾸세요 (SETUP.md 4단계):"
    echo "  Backlog / AI작업중 / 판단필요 / 검토대기 / 완료"
    ;;
  add)
    need_board
    repo="${1:?사용법: ai-board add <owner/repo> 제목 [본문]}"; title="${2:?제목이 필요합니다}"; body="${3:-}"
    url="$(gh issue create --repo "$repo" --title "$title" --body "$body")"
    gh project item-add "$BOARD_NUMBER" --owner "$OWNER" --url "$url" >/dev/null
    echo "$url"
    ;;
  move)
    need_board
    url="${1:?사용법: ai-board move <이슈URL> <상태>}"; status="${2:?상태가 필요합니다}"
    pid="$(gh project view "$BOARD_NUMBER" --owner "$OWNER" --format json | python3 -c 'import sys,json; print(json.load(sys.stdin)["id"])')"
    fields="$(gh project field-list "$BOARD_NUMBER" --owner "$OWNER" --format json)"
    items="$(gh project item-list "$BOARD_NUMBER" --owner "$OWNER" --format json --limit 500)"
    ids="$(FIELDS="$fields" ITEMS="$items" URL="$url" STATUS="$status" python3 - <<'PY'
import json, os, sys
fields = json.loads(os.environ["FIELDS"])["fields"]
items = json.loads(os.environ["ITEMS"])["items"]
st = next((f for f in fields if f["name"] == "Status"), None)
if not st: sys.exit("Status 필드를 찾지 못했습니다")
opt = next((o for o in st.get("options", []) if o["name"] == os.environ["STATUS"]), None)
if not opt: sys.exit("Status 옵션 '%s' 없음. 보드의 옵션: %s" % (os.environ["STATUS"], ", ".join(o["name"] for o in st.get("options", []))))
it = next((i for i in items if (i.get("content") or {}).get("url") == os.environ["URL"]), None)
if not it: sys.exit("보드에서 해당 이슈를 찾지 못했습니다: " + os.environ["URL"])
print(it["id"], st["id"], opt["id"])
PY
)"
    read -r item_id field_id opt_id <<<"$ids"
    gh project item-edit --project-id "$pid" --id "$item_id" --field-id "$field_id" --single-select-option-id "$opt_id" >/dev/null
    echo "→ $status : $url"
    ;;
  list)
    need_board
    gh project item-list "$BOARD_NUMBER" --owner "$OWNER" --limit 100
    ;;
  link)
    need_board
    repo="${1:?사용법: ai-board link <owner/repo>}"
    gh project link "$BOARD_NUMBER" --owner "$OWNER" --repo "$repo"
    ;;
  *)
    sed -n '2,8p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
    exit 2
    ;;
esac
