#!/usr/bin/env bash
# 프로젝트에 문서 규약 뼈대를 만든다. 이미 있는 파일은 절대 덮어쓰지 않는다.
#   ai-init <프로젝트 경로>     docs/STATUS.md, docs/decisions/, docs/plans/ 생성, CLAUDE.md 없으면 템플릿 생성
#   ai-init -n <경로>           실제로 만들지 않고 무엇을 만들지만 출력
set -euo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

dry=0
if [[ "${1:-}" == "-n" ]]; then dry=1; shift; fi
target="${1:?사용법: ai-init [-n] <프로젝트 경로>}"
[[ -d "$target" ]] || { echo "디렉터리가 없습니다: $target" >&2; exit 1; }
target="$(cd "$target" && pwd)"

do_mkdir() { if [[ -d "$1" ]]; then echo "  = 있음  ${1#$target/}"; else echo "  + 생성  ${1#$target/}/"; [[ $dry == 1 ]] || mkdir -p "$1"; fi; }
do_copy()  { # src dst
  if [[ -e "$2" ]]; then echo "  = 있음  ${2#$target/}"; else echo "  + 생성  ${2#$target/}"; [[ $dry == 1 ]] || cp "$1" "$2"; fi
}

echo "대상: $target $([[ $dry == 1 ]] && echo '(dry-run)')"
do_mkdir "$target/docs"
do_mkdir "$target/docs/decisions"
do_mkdir "$target/docs/plans"
do_copy "$ROOT/templates/STATUS.md" "$target/docs/STATUS.md"
do_copy "$ROOT/templates/CLAUDE.project.md" "$target/CLAUDE.md"

if [[ $dry == 0 && -f "$target/docs/STATUS.md" ]]; then
  # 새로 만든 템플릿의 날짜 자리표시자만 채운다 (이미 채워진 파일은 건드리지 않음)
  sed -i "s/^최종 갱신: YYYY-MM-DD HH:MM/최종 갱신: $(date '+%Y-%m-%d %H:%M')/" "$target/docs/STATUS.md"
fi
echo "완료. ai-status 가 이 프로젝트를 찾으려면 $target 이 ~ 아래 4단계 이내여야 합니다."
